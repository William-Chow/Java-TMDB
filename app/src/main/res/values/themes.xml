<resources>
    <!--
        The window theme only covers what shows before Compose draws: Compose paints every screen
        with ui/theme/Theme.kt. No action bar, and no status or navigation bar colours: the
        activities call enableEdgeToEdge(), and those colour attributes are deprecated in API 35.
        DayNight picks the light or dark window background, so values-night needs no copy.
    -->
    <style name="Theme.JavaTMDB" parent="Theme.Material3.DayNight.NoActionBar" />
</resources>
